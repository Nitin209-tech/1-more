# Server Configuration
PORT=5000
WEBSITE_URL=http://localhost:3000
JWT_SECRET=super_secret_jwt_token_key_change_me_in_production

# MongoDB Connection
MONGODB_URI=mongodb://127.0.0.1:27017/discord-invite-rewards

# Discord Bot Credentials
DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN
DISCORD_CLIENT_ID=YOUR_DISCORD_CLIENT_ID
DISCORD_CLIENT_SECRET=YOUR_DISCORD_CLIENT_SECRET
DISCORD_REDIRECT_URI=http://localhost:5000/api/auth/callback

# Discord Server (Guild) configuration
GUILD_ID=YOUR_GUILD_ID
STAFF_ROLE_ID=YOUR_STAFF_ROLE_ID
CLAIM_CATEGORY_ID=YOUR_CLAIM_CATEGORY_ID
COMPLETED_CLAIM_CATEGORY_ID=YOUR_COMPLETED_CLAIM_CATEGORY_ID
LOG_CHANNEL_ID=YOUR_LOG_CHANNEL_ID

# Alt Prevention / Invites Configuration
MIN_ACCOUNT_AGE_DAYS=7
CLAIM_CHANNEL_PREFIX=claim-
ALLOW_CLAIMANT_ACCESS=true
AUTO_DELETE_CLAIMS_DAYS=7
